# AIUB Students Finance Club - Environment Configuration

# Public Site URL (Used for Canonical URLs, OpenGraph, JSON-LD and XML Sitemap)
NEXT_PUBLIC_SITE_URL=https://aiubfinanceclub.org

# Supabase Database Configuration (Optional - turnkey local JSON persistence is active by default)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Search Console & Bing Webmaster Verification (Can also be set in CMS Admin Settings)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow API Key
INDEXNOW_API_KEY=asfc-indexnow-key-2026

